{
  "name": "hangar",
  "version": "1.4.0",
  "private": true,
  "description": "Open-source project management for self-hosted teams",
  "license": "AGPL-3.0",
  "repository": "https://github.com/szymczag/hangar.git",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency=18",
    "start": "turbo run start",
    "clean": "turbo run clean && rm -rf .turbo && rm -rf .next && rm -rf node_modules && rm -rf dist",
    "fix": "turbo run fix",
    "fix:format": "turbo run fix:format",
    "fix:lint": "turbo run fix:lint",
    "check": "turbo run check && pnpm check:branding && pnpm check:brand-assets && pnpm test:react-runtime-contracts",
    "check:branding": "git ls-files --cached | node scripts/check-branding.mjs --stdin",
    "check:brand-assets": "node assets/branding/generate-brand-assets.mjs --check",
    "generate:brand-assets": "node assets/branding/generate-brand-assets.mjs",
    "test:branding": "node --test scripts/check-branding.test.mjs",
    "test:community-billing": "node --test scripts/community-billing-page.test.mjs",
    "test:community-modal": "node scripts/community-modal.test.mjs",
    "test:react-runtime-contracts": "node --test apps/web/tests/*-contract.test.mjs",
    "test:admin-form-contracts": "node --test apps/admin/tests/*-contract.test.mjs",

    "check:lint": "turbo run check:lint",
    "check:format": "turbo run check:format",
    "check:types": "turbo run check:types",
    "prepare": "husky",
    "doctor": "npx react-doctor@latest"
  },
  "devDependencies": {
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "react-doctor": "^0.4.2",
    "sharp": "catalog:",
    "turbo": "catalog:"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cjs,mjs,cts,mts,json,css,md}": [
      "pnpm exec oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{js,jsx,ts,tsx,cjs,mjs,cts,mts}": [
      "pnpm exec oxlint --fix --deny-warnings"
    ]
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "pnpm@11.3.0+sha512.2c403d6594527287672b1f7056343a1f7c3634036a67ffabfcc2b3d7595d843768f8787148d1b57cf7956c90606bbd192857c363af19e96d2d0ec9ec5741d215"
}
