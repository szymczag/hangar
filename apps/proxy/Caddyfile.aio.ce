(plane_proxy) {
	request_body {
		max_size {$FILE_SIZE_LIMIT}
	}

    # Without the slash, /spaces would fall through to the web app; Compose
    # redirects it the same way (Caddyfile.ce).
    redir /spaces /spaces/ permanent
    handle /spaces/* {
        reverse_proxy localhost:3002
    }
	
    handle /live/* {
        reverse_proxy localhost:3005
    }
	handle /api/* {
        reverse_proxy localhost:3004
    }

	handle /auth/* {
        reverse_proxy localhost:3004
    }

	# Web and God Mode are the static builds of the web and admin images.
	# Their nginx sends security headers generated from each build by
	# @plane/csp; start.sh renders the same headers into these snippets
	# (render-security-headers.py), and Caddy refuses to start without them.
	handle_path /god-mode* {
        import /app/proxy/security-headers/admin.caddy
        root * /app/admin
        try_files {path} {path}/ /index.html
        file_server
    }
    handle_path /* {
        import /app/proxy/security-headers/web.caddy
        root * /app/web
        try_files {path} {path}/ /index.html
        file_server
    }
}

{
	{$CERT_EMAIL}
	acme_ca {$CERT_ACME_CA:https://acme-v02.api.letsencrypt.org/directory} 
	{$CERT_ACME_DNS}
	servers {
		max_header_size 25MB
		client_ip_headers X-Forwarded-For X-Real-IP
		trusted_proxies static {$TRUSTED_PROXIES:0.0.0.0/0}
	}
}

{$SITE_ADDRESS} {
	import plane_proxy
}