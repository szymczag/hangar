# Keep the readable patch version and immutable AMD64 manifest digest together.
# The release workflow currently publishes linux/amd64 only.
FROM docker.io/library/caddy:2.11.7-builder-alpine@sha256:420db7c0f6927c7e8140c666628915fb4a9141282fc5c344716ebf3879fe8f9b AS caddy-builder

RUN XCADDY_SKIP_CLEANUP=1 xcaddy build \
        --with github.com/caddy-dns/cloudflare@v0.2.1 \
        --with github.com/caddy-dns/digitalocean@04bde2867106aa1b44c2f9da41a285fa02e629c5 \
        --with github.com/mholt/caddy-l4@6faae83b167fda94e62b686be5cbeb9b3f8fe002 \
        --with github.com/go-jose/go-jose/v3@v3.0.5 \
        --with github.com/go-jose/go-jose/v4@v4.1.6 \
        --with google.golang.org/grpc@v1.83.2 \
        --with go.opentelemetry.io/otel@v1.46.0 \
        --with go.opentelemetry.io/otel/sdk@v1.46.0

# Caddy itself can pin vulnerable transitive Go modules. Upgrade them in the
# preserved xcaddy build directory and rebuild the exact module set.
RUN cd "$(find /tmp -maxdepth 1 -name 'buildenv_*' -type d | head -1)" && \
    go get golang.org/x/crypto@v0.58.0 && \
    go get golang.org/x/net@v0.62.0 && \
    go get golang.org/x/text@v0.43.0 && \
    go get google.golang.org/grpc@v1.83.2 && \
    go get github.com/go-jose/go-jose/v4@v4.1.6 && \
    go get go.opentelemetry.io/otel@v1.46.0 && \
    go get go.opentelemetry.io/otel/sdk@v1.46.0 && \
    go mod tidy && \
    go build -o /usr/bin/caddy -ldflags "-w -s" -trimpath -tags nobadger,nomysql,nopgx .

RUN go version -m /usr/bin/caddy | grep -qE 'golang.org/x/crypto[[:space:]]+v0.58.0[[:space:]]' && \
    go version -m /usr/bin/caddy | grep -qE 'golang.org/x/net[[:space:]]+v0.62.0[[:space:]]' && \
    go version -m /usr/bin/caddy | grep -qE 'golang.org/x/text[[:space:]]+v0.43.0[[:space:]]' && \
    go version -m /usr/bin/caddy | grep -qE 'google.golang.org/grpc[[:space:]]+v1.83.2[[:space:]]' && \
    go version -m /usr/bin/caddy | grep -qE 'github.com/go-jose/go-jose/v4[[:space:]]+v4.1.6[[:space:]]' && \
    go version /usr/bin/caddy | grep -qE ': go1\.(27\.([3-9]|[1-9][0-9])|(2[89]|[3-9][0-9])\.[0-9]+)$'

FROM docker.io/library/caddy:2.11.7-alpine@sha256:04913b1da43339a40ad1ea87827d70a576ac5aa6cf674c6e24fdca675887533a

ARG APK_SECURITY_PATCH=2026-09-08
RUN echo "apk-security-patch ${APK_SECURITY_PATCH}" && apk update && apk upgrade --no-cache --available && apk add --no-cache nss-tools bash curl

COPY --from=caddy-builder /usr/bin/caddy /usr/bin/caddy

COPY Caddyfile.ce /etc/caddy/Caddyfile
