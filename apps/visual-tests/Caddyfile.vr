#
# One origin for the visual regression stack, mirroring the routes
# apps/proxy/Caddyfile.ce serves in production.
#
# Single origin is not a convenience here, it is what removes the cookie problem
# entirely: no COOKIE_DOMAIN, no CORS configuration, and no SameSite reasoning,
# because the browser never leaves the origin it was given the session on.
#
# Published boards (space) and the live collaboration server are routed for the
# security suite; the visual suite photographs neither.
#
# Web and admin are served with the Content-Security-Policy their builds
# generated, enforced, and the default report-only Trusted Types policy
# (scripts/vr.mjs renders both); space sends its own. Violations are reported to
# the API, and `pnpm vr` fails on any.

:80 {
	# Every route is a `handle` block, deliberately. Caddy orders `handle`
	# ahead of a bare `reverse_proxy` regardless of where each appears in the
	# file, so mixing the two silently sends /api to the catch-all and the
	# browser receives the single-page app where it expected JSON.
	handle /api/* {
		reverse_proxy vr-api:8000
	}
	handle /auth/* {
		reverse_proxy vr-api:8000
	}
	handle /static/* {
		reverse_proxy vr-api:8000
	}
	# The bucket itself as well as its objects: a presigned upload posts to
	# /uploads, without a trailing slash.
	@uploads path /uploads /uploads/*
	handle @uploads {
		reverse_proxy vr-minio:9000
	}

	redir /spaces /spaces/ permanent
	handle /spaces/* {
		reverse_proxy vr-space:3000
	}
	handle /live/* {
		reverse_proxy vr-live:3000
	}

	redir /god-mode /god-mode/ permanent
	handle_path /god-mode/* {
		header Content-Security-Policy "{$VR_CSP_ADMIN}"
		header Content-Security-Policy-Report-Only "{$VR_CSP_TRUSTED_TYPES}"
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}

	handle {
		header Content-Security-Policy "{$VR_CSP_WEB}"
		header Content-Security-Policy-Report-Only "{$VR_CSP_TRUSTED_TYPES}"
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
