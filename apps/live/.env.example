PORT=3100
API_BASE_URL="http://localhost:8000"

WEB_BASE_URL="http://localhost:3000"

LIVE_BASE_URL="http://localhost:3100"
LIVE_BASE_PATH="/live"

# Shared by the API and Live. setup.sh generates one value into both .env files;
# Live refuses to start while it is empty or a template value.
LIVE_SERVER_SECRET_KEY=""
# Exact operator-trusted internal storage hosts permitted for PDF image fetches.
# Public destinations need no entry. Connections remain DNS-pinned.
PDF_ASSET_ALLOWED_HOSTS=""

# If you prefer not to provide a Redis URL, you can set the REDIS_HOST and REDIS_PORT environment variables instead.
REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_URL="redis://localhost:6379/"
