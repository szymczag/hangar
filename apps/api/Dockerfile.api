FROM python:3.12.10-alpine

# set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

# Update system packages for security
RUN apk upgrade --no-cache

WORKDIR /code

RUN apk add --no-cache --upgrade \
    "libpq" \
    "libxslt" \
    "xmlsec" \
    "ca-certificates" \
    "openssl"

COPY requirements.txt ./
COPY requirements ./requirements
RUN apk add --no-cache --virtual .build-deps \
    "bash~=5.2" \
    "g++" \
    "gcc" \
    "cargo" \
    "git" \
    "make" \
    "postgresql-dev" \
    "libc-dev" \
    "linux-headers" \
    "libffi-dev" \
    "xmlsec-dev" \
    "libxml2-dev" \
    "libxslt-dev" \
    && \
    pip install -r requirements.txt --compile --no-cache-dir \
    && \
    apk del .build-deps \
    && \
    rm -rf /var/cache/apk/*


# Add in Django deps and generate Django's static files
COPY manage.py manage.py
COPY plane plane/
COPY templates templates/
COPY package.json package.json

RUN apk --no-cache add "bash~=5.2"
COPY ./bin ./bin/

RUN addgroup -S -g 10001 hangar \
    && adduser -S -D -H -u 10001 -G hangar hangar \
    && mkdir -p /home/hangar /code/plane/logs /code/plane/static-assets /tmp \
    && chown -R 10001:10001 /home/hangar /code /tmp \
    && chmod 0750 /home/hangar /code/plane/logs /code/plane/static-assets \
    && chmod +x ./bin/*

ENV HOME=/home/hangar
ENV TMPDIR=/tmp

USER 10001:10001

# Expose container port and run entry point script
EXPOSE 8000

CMD ["./bin/docker-entrypoint-api.sh"]
