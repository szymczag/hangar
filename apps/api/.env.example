# Backend
# Debug value for api server use it as 0 for production use
DEBUG=0
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3100"

# Public Hangar links shown in help and legal surfaces
HANGAR_DOCUMENTATION_URL="https://github.com/szymczag/hangar#readme"
HANGAR_ISSUES_URL="https://github.com/szymczag/hangar/issues"
HANGAR_SECURITY_URL="https://github.com/szymczag/hangar/security/advisories/new"
# Leave empty to show the AGPL source notice instead of operator-specific policies.
HANGAR_TERMS_URL=""
HANGAR_PRIVACY_URL=""

# Database Settings
POSTGRES_USER="plane"
POSTGRES_PASSWORD="plane"
POSTGRES_HOST="plane-db"
POSTGRES_DB="plane"
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis Settings
REDIS_HOST="plane-redis"
REDIS_PORT="6379"
REDIS_URL="redis://${REDIS_HOST}:6379/"

# RabbitMQ Settings
RABBITMQ_HOST="plane-mq"
RABBITMQ_PORT="5672"
RABBITMQ_USER="plane"
RABBITMQ_PASSWORD="plane"
RABBITMQ_VHOST="plane"

# AWS Settings
AWS_REGION=""
AWS_ACCESS_KEY_ID="access-key"
AWS_SECRET_ACCESS_KEY="secret-key"
AWS_S3_ENDPOINT_URL="http://localhost:9000"
# Optional browser-facing endpoint for presigned URLs; defaults to the endpoint above.
AWS_S3_PUBLIC_ENDPOINT_URL=""
# Changing this requires change in the proxy config for uploads if using minio setup
AWS_S3_BUCKET_NAME="uploads"
# Private server-only bucket. Never route this bucket through the public proxy.
IMPORT_S3_BUCKET_NAME="uploads-imports"
# Maximum file upload limit
FILE_SIZE_LIMIT=5242880
# Remove incomplete direct uploads after this many hours
UNUPLOADED_ASSET_DELETE_HOURS=1
# Signed URL expiration time in seconds (default: 3600 = 1 hour)
# Set to 30 for 30 seconds, 300 for 5 minutes, etc.
SIGNED_URL_EXPIRATION=3600

# Settings related to Docker
DOCKERIZED=1 # deprecated

# set to 1 If using the pre-configured minio setup
USE_MINIO=0



# Email redirections and minio domain settings
WEB_URL="http://localhost:8000"

# SSO policy. Workspace mode requires a comma-separated hosted-domain allowlist.
GOOGLE_AUTH_MODE="generic"
GOOGLE_WORKSPACE_DOMAINS=""
# Start Google sign-in automatically when it is the only enabled login method.
GOOGLE_AUTO_REDIRECT="0"
# Optional immutable SAML assertion attribute; NameID is used when empty.
SAML_ATTR_SUBJECT=""

# Secure outbound email. Domain values below are reserved examples only.
# smtp, ses_smtp, or the recommended ses_api transport over HTTPS.
EMAIL_PROVIDER="smtp"
EMAIL_HOST=""
EMAIL_PORT="587"
EMAIL_HOST_USER=""
EMAIL_HOST_PASSWORD=""
EMAIL_USE_TLS="1"
EMAIL_USE_SSL="0"
EMAIL_FROM="Hangar <hello@hangar.example.com>"
EMAIL_REPLY_TO=""
EMAIL_SES_REGION="eu-central-1"
EMAIL_SES_CONFIGURATION_SET_AUTH="hangar-auth"
EMAIL_SES_CONFIGURATION_SET_NOTIFICATIONS="hangar-notifications"
EMAIL_SES_EVENTS_QUEUE_URL=""
EMAIL_SES_EVENTS_TOPIC_ARN=""
EMAIL_SES_ACCOUNT_ID=""
# Leave SES API credentials empty when the mail worker uses workload identity.
EMAIL_SES_AWS_ACCESS_KEY_ID=""
EMAIL_SES_AWS_SECRET_ACCESS_KEY=""
EMAIL_SES_AWS_SESSION_TOKEN=""
# Leave event-consumer credentials empty when a workload role is available.
EMAIL_EVENTS_AWS_ACCESS_KEY_ID=""
EMAIL_EVENTS_AWS_SECRET_ACCESS_KEY=""
EMAIL_EVENTS_AWS_SESSION_TOKEN=""
EMAIL_MESSAGE_ID_DOMAIN="hangar.example.com"
EMAIL_MAX_STORED_PAYLOAD_BYTES="8388608"
EMAIL_MAX_ATTACHMENT_BYTES="5242880"
EMAIL_SMTP_TIMEOUT_SECONDS="30"
# SMTP destinations are public-only by default. Add exact internal DNS names or
# CIDRs only when an operator intentionally uses a private relay. Keep the port
# allowlist narrow; credentials are rejected unless TLS or implicit SSL is on.
SMTP_ALLOWED_HOSTS=""
SMTP_ALLOWED_IPS=""
SMTP_ALLOWED_PORTS="25,465,587,2525"
EMAIL_GPG_BINARY="gpg"
EMAIL_OUTBOX_RETENTION_DAYS="7"
EMAIL_EVENT_RETENTION_DAYS="4"
EMAIL_AUDIT_RETENTION_DAYS="90"
EMAIL_DELIVERY_V2_ENABLED="0"
EMAIL_OPENPGP_ENABLED="0"

# Gitea OAuth destinations are public HTTPS-only by default. These deployment-
# owned exceptions are required for an intentionally private Gitea instance;
# changing GITEA_HOST in the administration UI cannot expand this boundary.
GITEA_ALLOWED_HOSTS=""
GITEA_ALLOWED_IPS=""

# Hangar Runner control plane. Workspaces remain inactive until an admin opts in.
RUNNER_ENABLED="0"
RUNNER_API_USER_READ_RATE="240/minute"
RUNNER_API_USER_MUTATION_RATE="60/minute"
RUNNER_API_READ_RATE="120/minute"
RUNNER_API_MUTATION_RATE="30/minute"

# Todoist imports are disabled unless an operator explicitly enables them.
TODOIST_IMPORTS_ENABLED="0"
TODOIST_IMPORT_LEASE_SECONDS="120"
TODOIST_IMPORT_RECOVERY_GRACE_SECONDS="30"
TODOIST_IMPORT_SOURCE_RETENTION_HOURS="24"

# Gunicorn Workers
GUNICORN_WORKERS=2

# Privacy: both this endpoint and the instance-admin opt-in are required before
# Hangar exports telemetry. Leave empty to disable all telemetry egress.
OTLP_ENDPOINT=""
OTLP_METRICS_PROTOCOL="grpc"

# Optional outbound release discovery. Leave empty for offline startup.
HANGAR_RELEASE_CHECK_URL=""

# Optional UI link. Hangar provides no vendor changelog fallback.
INSTANCE_CHANGELOG_URL=""

# Base URLs
ADMIN_BASE_URL="http://localhost:3001"
ADMIN_BASE_PATH="/god-mode"

SPACE_BASE_URL="http://localhost:3002"
SPACE_BASE_PATH="/spaces"

APP_BASE_URL="http://localhost:3000"
APP_BASE_PATH=""

LIVE_BASE_URL="http://localhost:3100"
LIVE_BASE_PATH="/live"

LIVE_SERVER_SECRET_KEY="secret-key"

# Hard delete files after days
HARD_DELETE_AFTER_DAYS=60

# Force HTTPS for handling SSL Termination
MINIO_ENDPOINT_SSL=0

# API key rate limit
API_KEY_RATE_LIMIT="60/minute"
